/*--------------------------------*- C++ -*----------------------------------*\
  roofpipe template (roof/templates/pcm_slab)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      surfaceFeatureExtractDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Edges sharper than 30 degrees: the base rim, the pyramid edges and the apex.
// The facets of the tessellated hemisphere (a few degrees apart) are not features.
pcm_body.stl
{
    extractionMethod    extractFromSurface;
    includedAngle       150;
    extractFromSurfaceCoeffs
    {
        includedAngle   150;
    }
    subsetFeatures
    {
        nonManifoldEdges no;
        openEdges       yes;
    }
    writeObj            yes;
}

